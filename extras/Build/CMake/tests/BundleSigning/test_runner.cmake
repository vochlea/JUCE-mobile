cmake_minimum_required(VERSION 3.22)

if(NOT test_dir)
    message(FATAL_ERROR "test_dir is required")
endif()
file(MAKE_DIRECTORY "${test_dir}")
set(mock "${test_dir}/mock cmake")
file(WRITE "${mock}" "#!/bin/sh\nprintf '<%s>' \"\$@\" >> \"\$BUNDLE_SIGNING_COMMAND_LOG\"\nprintf '\\n' >> \"\$BUNDLE_SIGNING_COMMAND_LOG\"\n")
file(CHMOD "${mock}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
set(CMAKE_COMMAND "${mock}")
set(CMAKE_CTEST_COMMAND "${mock}")
set(build_dir "${test_dir}/nested build")
set(osx_sysroot "/fixture/MacOSX.sdk")

if(case)
    set(cases "${case}")
else()
    set(cases intel-ninja intel-xcode arm-multi)
endif()
foreach(case IN LISTS cases)
    set(CMAKE_HOST_SYSTEM_PROCESSOR x86_64)
    set(generator Ninja)
    set(config Release)
    if(case STREQUAL "intel-xcode")
        set(generator Xcode)
        set(config RelWithDebInfo)
    elseif(case STREQUAL "arm-multi")
        set(CMAKE_HOST_SYSTEM_PROCESSOR arm64)
        set(generator "Ninja Multi-Config")
        set(config Debug)
    endif()
    set(log "${test_dir}/${case}.log")
    file(WRITE "${log}" "")
    set(ENV{BUNDLE_SIGNING_COMMAND_LOG} "${log}")
    include("${CMAKE_CURRENT_LIST_DIR}/run.cmake")
    file(READ "${log}" actual)
    set(expected "")
    foreach(mode manual-copy manual-local auto-copy auto-local)
        set(auto OFF)
        set(copy OFF)
        if(mode MATCHES "^auto")
            set(auto ON)
        endif()
        if(mode MATCHES "copy$")
            set(copy ON)
        endif()
        string(APPEND expected "<-S><${CMAKE_CURRENT_LIST_DIR}><-B><${build_dir}><-G><${generator}><-DCMAKE_BUILD_TYPE=${config}><-DCMAKE_OSX_ARCHITECTURES=${CMAKE_HOST_SYSTEM_PROCESSOR}><-DCMAKE_OSX_SYSROOT=${osx_sysroot}><-DAUTO_MANIFEST=${auto}><-DCOPY_PLUGIN=${copy}>\n")
        string(APPEND expected "<--build><${build_dir}><--config><${config}><-j><4>\n")
        string(APPEND expected "<--test-dir><${build_dir}><--build-config><${config}><--output-on-failure><--stop-on-failure>\n")
    endforeach()
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${case}: runner commands differ.\nExpected:\n${expected}\nActual:\n${actual}")
    endif()
    message(STATUS "${case}: all four configure/build/test command sequences passed")
endforeach()
